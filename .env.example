# Claudeway Environment Configuration

# API Settings
CLAUDWAY_API_HOST=0.0.0.0
CLAUDWAY_API_PORT=8000
CLAUDWAY_DEBUG=true

# Database
CLAUDWAY_DATABASE_URL=postgresql+asyncpg://claudeway:claudeway@localhost:5432/claudeway

# Redis
CLAUDWAY_REDIS_URL=redis://localhost:6379/0

# Claude-Flow
CLAUDWAY_CLAUDE_FLOW_URL=http://localhost:8080
CLAUDWAY_CLAUDE_FLOW_API_KEY=

# NATS
CLAUDWAY_NATS_URL=nats://localhost:4222
CLAUDWAY_NATS_USER=
CLAUDWAY_NATS_PASSWORD=

# JWT / Auth
CLAUDWAY_SECRET_KEY=change-this-to-a-random-string-in-production
CLAUDWAY_ALGORITHM=HS256
CLAUDWAY_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe (Billing)
CLAUDWAY_STRIPE_API_KEY=sk_test_your_stripe_key_here
CLAUDWAY_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
CLAUDWAY_STRIPE_PRICE_ID_PRO=price_your_pro_price_id
CLAUDWAY_STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_price_id

# Rate Limiting
CLAUDWAY_RATE_LIMIT_REQUESTS=100
CLAUDWAY_RATE_LIMIT_PERIOD=60

# Anthropic
CLAUDWAY_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
